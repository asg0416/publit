NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_MAPGLOT_KEY=

# Server-only. Never expose this with NEXT_PUBLIC_ and do not paste it into chat.
SUPABASE_SERVICE_ROLE_KEY=

# Optional server-only key. When present, new thoughts are cached in the other
# supported language and nearby reads use the visitor's locale automatically.
GOOGLE_TRANSLATE_API_KEY=
